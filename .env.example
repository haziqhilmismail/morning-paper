# The address where the e-reader reaches paper-web, with no slash at the end. News Downloader needs full URLs.
PAPER_URL=

# Time zone for the masthead date, the 7-day window and the curation cutoff (IANA name).
PAPER_TZ=UTC

# Curation (curate.sh) runs the Claude CLI with this token. Make one with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: the name of a running container that has the Claude CLI. Empty runs `claude` on the host.
CLAUDE_CONTAINER=
# Optional: count KOReader reading only from this date (YYYY-MM-DD), for example when the reader had an earlier owner.
READING_SINCE=

# Optional: the key that lets the phone reader save its reading log to /dav/web/ (Caddyfile, user "sync").
# Make one with: python3 -c 'import secrets; print(secrets.token_hex(4))'
READER_SYNC_KEY=

# Optional Telegram bot (bot.py): the token from @BotFather and your own chat id.
PAPER_BOT_TOKEN=
PAPER_BOT_CHAT_ID=
